#!/usr/bin/env sh

echo "🔍 Running pre-commit checks..."

if git diff --cached --name-only | grep -q '^packages/'; then
  echo "📦 [packages] Staged changes detected"
  cd packages
  echo "  → [packages] pwd: $(pwd)"
  echo "  → [packages] Running lint-staged..."
  bun --bun lint-staged || { echo "❌ [packages] lint-staged failed"; exit 1; }
  echo "  → [packages] Running typecheck..."
  bun --bun typecheck || { echo "❌ [packages] typecheck failed"; exit 1; }
  cd ..
  echo "✅ [packages] Passed"
else
  echo "⏭️  [packages] No staged changes, skipping"
fi

if git diff --cached --name-only | grep -q '^docs/'; then
  echo "📦 [docs] Staged changes detected"
  cd docs
  echo "  → [docs] pwd: $(pwd)"
  echo "  → [docs] Running lint-staged..."
  bun --bun lint-staged || { echo "❌ [docs] lint-staged failed"; exit 1; }
  echo "  → [docs] Running typecheck..."
  bun --bun typecheck || { echo "❌ [docs] typecheck failed"; exit 1; }
  cd ..
  echo "✅ [docs] Passed"
else
  echo "⏭️  [docs] No staged changes, skipping"
fi

echo "🎉 All pre-commit checks passed"
